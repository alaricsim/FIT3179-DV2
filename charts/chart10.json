{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "description": "Grouped bar chart showing the proportion of reported Greater Sydney bus KPI observations that met or missed their performance target from January 2023 to May 2024.",

  "width": 820,
  "height": 430,

  "data": {
    "url": "data/nsw_bus_kpi_performance.csv",

    "format": {
      "type": "csv",

      "parse": {
        "met_pct": "number",
        "missed_pct": "number"
      }
    }
  },

  "transform": [
    {
      "fold": [
        "met_pct",
        "missed_pct"
      ],

      "as": [
        "status",
        "percentage"
      ]
    },

    {
      "calculate": "datum.status == 'met_pct' ? 'Met target' : 'Missed target'",

      "as": "StatusLabel"
    }
  ],

  "mark": {
    "type": "bar",

    "cornerRadiusEnd": 3
  },

  "encoding": {
    "x": {
      "field": "metric",
      "type": "nominal",

      "sort": [
        "First-stop on-time running",
        "Cancelled / incomplete trips",
        "Customer complaints",
        "First-stop tracking",
        "Mid-stop tracking",
        "Last-stop tracking"
      ],

      "title": null,

      "axis": {
        "labelAngle": -30,

        "labelAlign": "right",

        "labelFontSize": 11,
        "labelColor": "#132a2f",

        "labelLimit": 150,

        "labelPadding": 10,

        "domain": false,
        "ticks": false
      }
    },

    "xOffset": {
      "field": "StatusLabel"
    },

    "y": {
      "field": "percentage",
      "type": "quantitative",

      "title": "Reported observations (%)",

      "scale": {
        "domain": [
          0,
          100
        ]
      },

      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],

        "labelExpr": "datum.value + '%'",

        "labelFontSize": 11,
        "labelColor": "#637174",

        "titleFontSize": 12,
        "titleColor": "#637174",

        "titlePadding": 14,

        "domain": false,
        "ticks": false,

        "grid": true,
        "gridColor": "#132a2f",
        "gridOpacity": 0.08
      }
    },

    "color": {
      "field": "StatusLabel",
      "type": "nominal",

      "title": null,

      "scale": {
        "domain": [
          "Met target",
          "Missed target"
        ],

        "range": [
          "#4f8f79",
          "#d96850"
        ]
      },

      "legend": {
        "orient": "bottom",

        "direction": "horizontal",

        "labelFontSize": 11,
        "labelColor": "#637174",

        "symbolSize": 150
      }
    },

    "tooltip": [
      {
        "field": "metric",
        "type": "nominal",
        "title": "Performance measure"
      },

      {
        "field": "StatusLabel",
        "type": "nominal",
        "title": "Result"
      },

      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Share of observations",
        "format": ".1f"
      },

      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      }
    ]
  },

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Inter",

    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter"
    }
  }
}