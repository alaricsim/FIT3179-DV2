{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "description": "Scatter plot comparing pre-COVID capital-city public transport patronage with state and territory public transport commuting reliance.",

  "width": 820,
  "height": 470,

  "data": {
    "url": "data/network_scale_vs_commute_reliance.csv",

    "format": {
      "type": "csv",
      "parse": {
        "patronage_millions_2018_19": "number",
        "public_transport_commute_share_2016": "number"
      }
    }
  },

  "layer": [
    {
      "transform": [
        {
          "regression": "public_transport_commute_share_2016",
          "on": "patronage_millions_2018_19"
        }
      ],

      "mark": {
        "type": "line",

        "color": "#132a2f",

        "strokeWidth": 2,

        "strokeDash": [
          6,
          5
        ],

        "opacity": 0.35
      },

      "encoding": {
        "x": {
          "field": "patronage_millions_2018_19",
          "type": "quantitative"
        },

        "y": {
          "field": "public_transport_commute_share_2016",
          "type": "quantitative"
        }
      }
    },

    {
      "mark": {
        "type": "point",

        "filled": true,

        "size": 220,

        "color": "#e85d3f",

        "stroke": "#ffffff",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "patronage_millions_2018_19",
          "type": "quantitative",

          "title": "Capital-city patronage, 2018–19 (million trips)",

          "scale": {
            "domain": [
              0,
              850
            ]
          },

          "axis": {
            "values": [
              0,
              200,
              400,
              600,
              800
            ],

            "labelFontSize": 11,
            "labelColor": "#637174",

            "titleFontSize": 12,
            "titleColor": "#637174",

            "titlePadding": 15,

            "domain": false,
            "ticks": false,

            "grid": true,
            "gridColor": "#132a2f",
            "gridOpacity": 0.07
          }
        },

        "y": {
          "field": "public_transport_commute_share_2016",
          "type": "quantitative",

          "title": "Public transport share of one-method commuters (%)",

          "scale": {
            "domain": [
              0,
              16
            ]
          },

          "axis": {
            "values": [
              0,
              4,
              8,
              12,
              16
            ],

            "labelExpr": "datum.value + '%'",

            "labelFontSize": 11,
            "labelColor": "#637174",

            "titleFontSize": 12,
            "titleColor": "#637174",

            "titlePadding": 15,

            "domain": false,
            "ticks": false,

            "grid": true,
            "gridColor": "#132a2f",
            "gridOpacity": 0.07
          }
        },

        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },

          {
            "field": "patronage_millions_2018_19",
            "type": "quantitative",
            "title": "2018–19 patronage (million)",
            "format": ".1f"
          },

          {
            "field": "public_transport_commute_share_2016",
            "type": "quantitative",
            "title": "2016 commute share",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",

        "align": "left",
        "baseline": "middle",

        "dx": 10,
        "dy": -10,

        "font": "Inter",

        "fontSize": 11,
        "fontWeight": 700,

        "color": "#132a2f"
      },

      "encoding": {
        "x": {
          "field": "patronage_millions_2018_19",
          "type": "quantitative"
        },

        "y": {
          "field": "public_transport_commute_share_2016",
          "type": "quantitative"
        },

        "text": {
          "field": "city"
        }
      }
    }
  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Inter"
  }
}